{
  "name": "teachbuddy",
  "version": "1.0.0",
  "description": "TeachBuddy — grammar notes, topic practice, mixed practice and an AI communication coach.",
  "main": "data/server.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node data/server.js",
    "build": "npm run build:css && npm run build:manifest",
    "build:css": "tailwindcss -i ./css/tailwind.css -o ./css/output.css --minify",
    "build:manifest": "node scripts/build-manifest.mjs",
    "watch": "tailwindcss -i ./css/tailwind.css -o ./css/output.css --watch"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "compression": "^1.7.5",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "openai": "^6.22.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.1"
  }
}
